{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Drop App 主窗口默认能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "log:default",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
