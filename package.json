{
  "name": "drop-app",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "跨平台桌面文件传输助手（类似微信文件传输助手）",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "tauri": "tauri",
    "mac:check": "node scripts/check-macos.mjs",
    "mac:dev": "npm run mac:check && tauri dev",
    "mac:build": "npm run mac:check && tauri build --bundles app,dmg"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0"
  }
}
